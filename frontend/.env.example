# Public client-side configuration (safe to commit — NEXT_PUBLIC_* is
# embedded into the browser bundle by design, never put secrets here).
# Copy to .env.local and fill in your Supabase project values.

# Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable/anon key (public by design)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# FastAPI backend origin (the app appends /api/v1 itself).
# Single-domain production deployment serves both from one origin:
# NEXT_PUBLIC_API_BASE_URL=https://mimic42.zomb.top
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
