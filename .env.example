# Backend configuration template (safe to commit — values only, no secrets).
# Copy to .env (gitignored) and fill in. Local .env points at the TEST
# Supabase project; production values live only in /etc/mimic42.env
# on the server and are never committed.

# Supabase project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# SQLAlchemy connection string, e.g. postgresql+asyncpg://postgres:PASSWORD@db.xyz.supabase.co:5432/postgres
DATABASE_CONNECTION_STRING=
# Long-term memory provider
MEM0_API_KEY=
# LLM provider (OpenRouter)
OPENROUTER_API_KEY=
# Fernet key for encrypting Telegram sessions at rest in the database.
# MUST match the key that encrypted existing sessions, otherwise stored
# sessions cannot be restored after a restart.
SECRET_KEY=
# Deployment-wide Telegram application (fallback when onboarding omits them)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Comma-separated browser origins allowed to call the API directly.
# Single-domain production deployment serves frontend and API from one
# origin, so this is a single entry; local development needs both.
CORS_ALLOW_ORIGINS=https://mimic42.zomb.top
